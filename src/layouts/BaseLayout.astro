---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  date?: string;
  tags?: string[];
}

const {
  title = "Silicon Pen — Penning Down the Language of Electronics",
  description = "Independent writing on electronics, hardware, embedded systems, and engineering thought.",
  image = "/images/cover.webp",
  article = false,
  date,
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://siliconpen.com");
const imageURL = new URL(image, Astro.site || "https://siliconpen.com");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme Flash Prevention -->
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('sp_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          if (theme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Title & SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {tags && tags.length > 0 && (
      <meta name="keywords" content={tags.join(', ')} />
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Silicon Pen" />
    {article && date && (
      <meta property="article:published_time" content={date} />
    )}
    {article && tags && tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google Structured Data (JSON-LD) for Rich Article Snippets -->
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "image": imageURL.toString(),
        "datePublished": date,
        "author": {
          "@type": "Person",
          "name": "Rishi",
          "url": "https://siliconpen.com/about.html"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Silicon Pen",
          "url": "https://siliconpen.com"
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalURL.toString()
        },
        ...(tags && tags.length > 0 ? { "keywords": tags.join(', ') } : {})
      })} />
    )}

    <!-- RSS Auto-Discovery -->
    <link rel="alternate" type="application/rss+xml" title="SiliconPen RSS Feed" href="/rss.xml" />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-22XHW1HR4J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      // Only track in production (ignore localhost / local preview traffic)
      if (window.location.hostname !== "localhost" && window.location.hostname !== "127.0.0.1") {
        gtag("config", "G-22XHW1HR4J");
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- MathJax for LaTeX/Math rendering -->
    <script
      id="MathJax-script"
      async
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
    ></script>

    <!-- SiliconPen Custom Web Components (<sp-lab>, <sp-quiz>, etc.) -->
    <script src="/js/custom-elements.js" defer></script>
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>
