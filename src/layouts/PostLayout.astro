---
import BaseLayout from './BaseLayout.astro';
import ShareRow from '../components/ShareRow.astro';
import Comments from '../components/Comments.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import ArticleFeedback from '../components/ArticleFeedback.astro';
import seriesData from '../data/series.json';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  date: string;
  cover?: string;
  series?: string;
  order?: number;
  tags?: string[];
  slug?: string;
}

const {
  title,
  subtitle,
  description = subtitle || title,
  date,
  cover,
  series,
  order,
  tags = [],
  slug,
} = Astro.props;

// Auto-calculate Series Track info, Chapter Progress, and Previous / Next Chapter
let seriesMeta: { name: string; description: string; cover: string } | null = null;
let currentChapter = 0;
let totalChapters = 0;
let progressPercent = 0;
let prevPost: any = null;
let nextPost: any = null;

if (series) {
  seriesMeta = (seriesData as Record<string, { name: string; description: string; cover: string }>)[series] || {
    name: series.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
    description: `Articles in the ${series} series.`,
    cover: '/images/cover.webp'
  };

  const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.series === series);
  // Sort by order or by date
  allPosts.sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return a.data.date.localeCompare(b.data.date);
  });

  totalChapters = allPosts.length;
  const currentIndex = allPosts.findIndex(p => (slug && p.id === slug) || p.data.title === title || (order !== undefined && p.data.order === order));
  if (currentIndex !== -1) {
    currentChapter = currentIndex + 1;
    progressPercent = Math.round((currentChapter / totalChapters) * 100);
    if (currentIndex > 0) {
      prevPost = allPosts[currentIndex - 1];
    }
    if (currentIndex < allPosts.length - 1) {
      nextPost = allPosts[currentIndex + 1];
    }
  }
}

const fullUrl = new URL(Astro.url.pathname, Astro.site || "https://siliconpen.com").toString();
---

<BaseLayout title={`${title} — Silicon Pen`} description={description} image={cover} article={true}>
  <main class="page-main">
    <article class="container post-article">
    <!-- Hero Header -->
    <header class="post-hero-wrapper">
      {series && seriesMeta && (
        <div class="post-series-banner">
          <div class="series-banner-top">
            <a href={`/series/${series}.html`} class="series-banner-track" title="View all chapters in this curriculum">
              <span class="series-banner-icon">📚</span>
              <span class="series-banner-name">{seriesMeta.name}</span>
              <span class="series-banner-arrow">&rarr;</span>
            </a>
            <div class="series-banner-metrics">
              <span class="series-banner-step">
                Chapter <strong>{String(currentChapter).padStart(2, '0')}</strong> of {String(totalChapters).padStart(2, '0')}
              </span>
              <span class="series-banner-pct">{progressPercent}% Track Complete</span>
            </div>
          </div>
          <div class="series-banner-progress-track">
            <div class="series-banner-progress-bar" style={`width: ${progressPercent}%;`}></div>
          </div>
        </div>
      )}

      {cover && (
        <div class="post-hero">
          <img src={cover} alt={title} class="post-hero-image" />
        </div>
      )}
      <h1 class="post-title-main">{title}</h1>
      {subtitle && <p class="post-subtitle-bar">“{subtitle}”</p>}
    </header>

    <!-- Meta bar -->
    <div class="post-meta-bar">
      <span class="post-date">{date}</span>
      <span class="post-reading-time" id="reading-time"></span>
    </div>

    <!-- Scroll Progress -->
    <div class="scroll-progress-bar">
      <div class="scroll-progress-fill"></div>
    </div>

    <!-- Main Content Layout -->
    <div class="post-layout">
      <div id="post-left" class="post-left"></div>

      <section class="post-content-shell">
        <div class="post-main">
          <div class="post-content">
            <slot />
            
            <!-- In-Article Newsletter & Resource Download -->
            <NewsletterBox
              title="Enjoyed this deep dive?"
              description="Get raw engineering breakdowns and companion circuit schematics straight to your inbox."
              source={Astro.url.pathname}
            />
          </div>
        </div>
      </section>

      <!-- Dynamic Table of Contents -->
      <aside class="post-toc">
        {series && seriesMeta && (
          <div class="toc-series-box">
            <div class="toc-series-label">CURRICULUM TRACK</div>
            <a href={`/series/${series}.html`} class="toc-series-title">
              {seriesMeta.name}
            </a>
            <div class="toc-series-meter-bar">
              <div class="toc-series-meter-fill" style={`width: ${progressPercent}%;`}></div>
            </div>
            <div class="toc-series-stats">
              <span>Chapter {currentChapter} of {totalChapters}</span>
              <span>{progressPercent}%</span>
            </div>
            <div class="toc-series-nav-row">
              {prevPost ? (
                <a href={`/posts/${prevPost.id}.html`} class="toc-nav-btn prev" title={prevPost.data.title}>
                  &larr; Ch {currentChapter - 1}
                </a>
              ) : (
                <span class="toc-nav-btn disabled">&larr; Start</span>
              )}
              {nextPost ? (
                <a href={`/posts/${nextPost.id}.html`} class="toc-nav-btn next" title={nextPost.data.title}>
                  Ch {currentChapter + 1} &rarr;
                </a>
              ) : (
                <span class="toc-nav-btn disabled">Complete &check;</span>
              )}
            </div>
          </div>
        )}

        <div class="post-toc-title">On this page</div>
        <nav id="post-toc-list"></nav>
      </aside>
    </div>

    <!-- Post Footer: Sharing, Tags, Series Navigation, Comments -->
    <section class="post-footer-extra">
      <ShareRow title={title} url={fullUrl} />

      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(t => (
            <a href={`/tags.html?tag=${encodeURIComponent(t)}`} class="tag-chip">
              #{t}
            </a>
          ))}
        </div>
      )}

      <!-- Automated Previous / Next Series Curriculum Navigation -->
      {(prevPost || nextPost) && (
        <div class="post-curriculum-footer">
          <div class="curriculum-footer-header">
            <span class="curriculum-footer-badge">CURRICULUM TRACK</span>
            <h2 class="curriculum-footer-title">
              {nextPost
                ? `Up Next in ${seriesMeta ? seriesMeta.name : 'this series'}`
                : `You've Completed the ${seriesMeta ? seriesMeta.name : 'Series'} Track!`}
            </h2>
            <p class="curriculum-footer-sub">
              Chapter {currentChapter} of {totalChapters} &bull; {progressPercent}% of track completed
            </p>
          </div>

          <div class="curriculum-footer-grid">
            {prevPost && (
              <a href={`/posts/${prevPost.id}.html`} class="curriculum-card prev">
                <div class="curriculum-card-badge">&larr; PREVIOUS CHAPTER</div>
                <div class="curriculum-card-step">Chapter {String(currentChapter - 1).padStart(2, '0')}</div>
                <h3 class="curriculum-card-title">{prevPost.data.title}</h3>
                <span class="curriculum-card-action">&larr; Review previous topic</span>
              </a>
            )}
            {nextPost && (
              <a href={`/posts/${nextPost.id}.html`} class="curriculum-card next">
                <div class="curriculum-card-badge">NEXT CHAPTER &rarr;</div>
                <div class="curriculum-card-step">Chapter {String(currentChapter + 1).padStart(2, '0')}</div>
                <h3 class="curriculum-card-title">{nextPost.data.title}</h3>
                <div class="curriculum-card-btn">
                  <span>Continue Learning</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <polygon points="5,3 19,12 5,21" />
                  </svg>
                </div>
              </a>
            )}
          </div>

          {series && seriesMeta && (
            <div class="curriculum-footer-all">
              <a href={`/series/${series}.html`} class="curriculum-all-link">
                View Full {seriesMeta.name} Syllabus ({totalChapters} Chapters) &rarr;
              </a>
            </div>
          )}
        </div>
      )}

      <!-- Community Feedback & GitHub Actions -->
      <ArticleFeedback title={title} slug={slug} url={fullUrl} />

      <Comments />
    </section>
  </article>
  </main>

  <!-- Lightbox Modal for Schematics and Diagrams -->
  <div id="sp-lightbox" class="sp-lightbox" aria-hidden="true" role="dialog">
    <div class="sp-lightbox-backdrop" id="sp-lightbox-backdrop"></div>
    <div class="sp-lightbox-dialog">
      <button class="sp-lightbox-close" id="sp-lightbox-close" type="button" aria-label="Close image">✕</button>
      <img id="sp-lightbox-img" src="" alt="" />
      <p id="sp-lightbox-caption" class="sp-lightbox-caption"></p>
    </div>
  </div>
</BaseLayout>

<script>
  function initPostFeatures() {
    // 1. Reading Time
    const contentEl = document.querySelector(".post-content") as HTMLElement;
    const readingEl = document.getElementById("reading-time");
    if (contentEl && readingEl) {
      const text = contentEl.innerText || "";
      const words = text.trim().split(/\s+/).length;
      const minutes = Math.max(1, Math.round(words / 200));
      readingEl.textContent = `${minutes} min read`;
    }

    // 2. Dynamic Table of Contents
    const tocList = document.getElementById("post-toc-list");
    if (contentEl && tocList) {
      tocList.innerHTML = "";
      const headings = contentEl.querySelectorAll("h1, h2");
      if (!headings.length) {
        const tocContainer = tocList.closest(".post-toc") as HTMLElement;
        if (tocContainer) tocContainer.style.display = "none";
      } else {
        const items: { heading: Element; link: HTMLAnchorElement }[] = [];
        headings.forEach((h) => {
          if (!h.id) {
            h.id = (h.textContent || "")
              .trim()
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/(^-|-$)/g, "");
          }
          const level = h.tagName === "H1" ? 2 : 3;
          const link = document.createElement("a");
          link.href = `#${h.id}`;
          link.textContent = h.textContent?.trim() || "";
          link.className = `toc-link toc-level-${level}`;

          const wrapper = document.createElement("div");
          wrapper.appendChild(link);
          tocList.appendChild(wrapper);
          items.push({ heading: h, link });
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const item = items.find((i) => i.heading === entry.target);
              if (!item) return;
              if (entry.isIntersecting) {
                items.forEach((i) => i.link.classList.remove("active"));
                item.link.classList.add("active");
              }
            });
          },
          { rootMargin: "-40% 0px -55% 0px", threshold: 0.1 }
        );
        items.forEach(({ heading }) => observer.observe(heading));
      }
    }

    // 3. Scroll Progress
    const fill = document.querySelector(".scroll-progress-fill") as HTMLElement;
    if (fill) {
      const updateProgress = () => {
        const doc = document.documentElement;
        const scrollTop = doc.scrollTop || document.body.scrollTop;
        const scrollHeight = doc.scrollHeight - doc.clientHeight;
        const percent = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        fill.style.width = percent + "%";
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }

    // 4. IDE-Style Code Blocks & Interactive Copy
    document.querySelectorAll(".post-content pre").forEach((pre) => {
      if (pre.closest(".ide-window")) return;

      const codeEl = pre.querySelector("code");
      const rawCode = codeEl ? codeEl.innerText : (pre as HTMLElement).innerText;

      // Infer code language
      let lang = "Code";
      const classAttr = (codeEl?.className || "") + " " + pre.className;
      const langMatch = classAttr.match(/language-(\w+)/i);
      if (langMatch) {
        lang = langMatch[1].toUpperCase();
      } else if (/void\s+(setup|loop)\s*\(|pinMode|digitalWrite|analogRead|#include/i.test(rawCode)) {
        lang = "Arduino / C++";
      } else if (/import\s+[\w.]+|def\s+\w+\s*\(/.test(rawCode)) {
        lang = "Python";
      } else if (/^(npm|git|npx|cd|mkdir)\s+/m.test(rawCode)) {
        lang = "Terminal";
      } else if (/\{[\s\S]*"[\w]+"\s*:/.test(rawCode)) {
        lang = "JSON";
      }

      // Create IDE window wrapper
      const windowDiv = document.createElement("div");
      windowDiv.className = "ide-window";

      const header = document.createElement("div");
      header.className = "ide-header";
      header.innerHTML = `
        <div class="ide-dots">
          <span class="ide-dot ide-dot-red"></span>
          <span class="ide-dot ide-dot-yellow"></span>
          <span class="ide-dot ide-dot-green"></span>
        </div>
        <span class="ide-lang-badge">${lang}</span>
        <button class="ide-copy-btn" type="button" aria-label="Copy code">
          <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-text">Copy</span>
        </button>
      `;

      const copyBtn = header.querySelector(".ide-copy-btn") as HTMLButtonElement;
      const copyText = copyBtn.querySelector(".copy-text") as HTMLElement;
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(rawCode.trim()).then(() => {
          copyBtn.classList.add("copied");
          copyText.textContent = "Copied!";
          setTimeout(() => {
            copyBtn.classList.remove("copied");
            copyText.textContent = "Copy";
          }, 1800);
        });
      };

      pre.parentNode?.insertBefore(windowDiv, pre);
      windowDiv.appendChild(header);
      windowDiv.appendChild(pre);
    });

    // 5. Click-to-Zoom Schematic Lightbox
    const lightbox = document.getElementById("sp-lightbox");
    const lightboxImg = document.getElementById("sp-lightbox-img") as HTMLImageElement;
    const lightboxCaption = document.getElementById("sp-lightbox-caption") as HTMLElement;
    const closeBtn = document.getElementById("sp-lightbox-close");
    const backdrop = document.getElementById("sp-lightbox-backdrop");

    if (lightbox && lightboxImg) {
      const closeLightbox = () => {
        lightbox.classList.remove("active");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      closeBtn?.addEventListener("click", closeLightbox);
      backdrop?.addEventListener("click", closeLightbox);
      lightboxImg.addEventListener("click", closeLightbox);

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.classList.contains("active")) {
          closeLightbox();
        }
      });

      document.querySelectorAll(".post-content img").forEach((imgEl) => {
        const img = imgEl as HTMLImageElement;
        img.addEventListener("click", () => {
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt || "SiliconPen schematic illustration";
          if (lightboxCaption) {
            lightboxCaption.textContent = img.alt || "";
            lightboxCaption.style.display = img.alt ? "block" : "none";
          }
          lightbox.classList.add("active");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        });
      });
    }
  }

  initPostFeatures();
  document.addEventListener('astro:after-swap', initPostFeatures);
</script>
